{
  "layer": "top",
  "position": "top",
  "margin-bottom": 1,
  "spacing" : 4,
  "modules-left": [
  "sway/workspaces",
  "sway/mode",
  "sway/scratchpad",
  "custom/uptime",
  "custom/uair",
  "custom/music",
  ],

  "modules-center": ["clock"],

  "modules-right": [
    "idle_inhibitor",
    "cpu",
    "bluetooth",
    "network",
    "wireplumber",
    "tray",
    "backlight",
    "battery",
    "custom/poweroff",
  ],

  "sway/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "default": "",
      "focus": "",
    }
  },

  "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
  },

  "sway/scratchpad": {
      "format": "{icon} {count}",
      "show-empty": false,
      "format-icons": ["", ""],
      "tooltip": true,
      "tooltip-format": "{app}: {title}"
  },

  "bluetooth": {
    "format": "\uf293",
    "format-on": "{icon}",
    "format-off": "{icon}",
    "format-connected":"{icon}",
    "format-icons":{
        "on":"\uf293",
        "off": "\uf293",
        "connected": "\uf293",
        },
    "on-click": "blueman-manager",
    "tooltip-format-connected":"{device_enumerate}"
  },

  "custom/music": {
    "format": "  {}",
    "format-alt": " ",
    "escape": true,
    "interval": 5,
    "exec": "playerctl metadata --format='{{ artist }} - {{ title }}'",
    "on-click": "playerctl play-pause",
    "tooltip-format": "{artist} - {title}",
    "max-length": 50
  },

  "clock": {
    "timezone": "Europe/Berlin",
    "tooltip": true,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small><span font='Noto Sans Mono'>{calendar}</span></small></tt>  ",
    "format-alt": "{:%H:%M:%S}  ",
    "format": "{:%A, %d %B, %Y @ %H:%M}",
    "interval": 1
  },

  "network": {
    "format-wifi": " ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": " ",
    "interval": 5,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "nm-connection-editor"
 },

  "cpu": {
    "interval": 1,
    "format": "  {usage:>2}%",
    "on-click": "alacritty -e btop"
  },

  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "Memory"
  },

  "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
  },

  "custom/uptime": {
    "format": "{}",
    "format-icon": [""],
    "tooltip": false,
    "interval": 1600,
    "exec": "$HOME/.config/waybar/scripts/uptime.sh"
  },

  "backlight": {
        "format": "{icon}  {percent}%",
	"format-icons": ["\uf185"],
        "tooltip": false,
  },

  "wireplumber": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_SINK@ toggle",
  },

  "battery": {
        "interval":2,
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-full": "{icon}  {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
  },

  "custom/poweroff": {
  "format": "\uf011",
  "exec": "uptime -p",
  "on-click" : "sh -c 'lock-suspend'",
  "tooltip-format": "{}"
  },

  "custom/lock": {
  "tooltip": false,
  "on-click": "sh -c '(sleep 0s; swaylock)' & disown",
  "format" : ""
  },

  "custom/uair": {
  "format": "{icon}",
  "format-alt": "{icon} {}",
  "format-icons": [
    "○○○○○○○○○●",
    "○○○○○○○○●●",
    "○○○○○○●●●●",
    "○○○○○●●●●●",
    "○○○○●●●●●●",
    "○○○●●●●●●●",
    "○○●●●●●●●●",
    "○●●●●●●●●●",
    "●●●●●●●●●●"
  ],
  "tooltip-format": "{icon} {}",
  "return-type": "json",
  "interval": 1,
  "on-click": "uairctl toggle",
  "on-click-middle": "uairctl prev",
  "on-click-right": "uairctl next",
  "exec": "uairctl fetch '{\"text\":\"{name} {time} {percent}%\",\"class\":\"{state}\",\"percentage\":{percent}}'"
  }
}
