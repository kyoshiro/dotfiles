### Startup programs
exec dbus-update-activation-environment --systemd DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=sway &
#exec --no-startup-id dbus-update-activation-environment --all &
exec /usr/libexec/polkit-kde-authentication-agent-1 &
#exec --no-startup-id xcompmgr -c -C -t5 -l5 -r4.2 -o.55 &
#exec --no-startup-id xinput --disable 13
#exec --no-startup-id xinput --disable 14
# With Gentoo OpenRC we need to run gentoo-pipewire-launcher to get audio
exec gentoo-pipewire-launcher restart &
exec --no-startup-id uair -q &
exec --no-startup-id swaymsg 'workspace 1; exec sleep 5 && exec nextcloud --background' &
exec --no-startup-id swaymsg 'workspace 1; exec sleep 5 && exec proton-mail-bridge-gui' &
exec --no-startup-id swaymsg 'workspace 1; exec blueman-applet &
exec --no-startup-id swaymsg 'workspace 1; exec swaync &
##exec --no-startup-id swaymsg 'workspace 1; exec koi' &
exec --no-startup-id swaymsg 'workspace 4; exec keepassxc' &
#exec --no-startup-id swaymsg 'workspace 2; exec firefox' &
#exec --no-startup-id swaymsg 'workspace 6; exec discord' &
#exec --no-startup-id swaymsg 'workspace 3; exec thunderbird' &
exec --no-startup-id swaymsg 'workspace 1; exec alacritty' &
# Check gtk theme settings and apply theme
#exec_always --no-startup-id ~/.cargo/bin/workstyle &> /tmp/workstyle.log
exec_always --no-startup-id ~/.config/sway/scripts/import-gsettings
exec_always --no-startup-id kanshi
